# Writes a C++ source file that holds a file's bytes, for a library that must not depend on Qt resources (which a
# static library would have to initialize and export). Run as a script:
#   cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DHEADER=<header> -DFUNCTION=<name> -P EmbedFile.cmake
# The source defines `std::span<const std::byte> rocketplot::<name>()`, declared in <header>. The bytes are an array of
# integers, not a string literal: MSVC limits string literals to 64 KB.

foreach(variable INPUT OUTPUT HEADER FUNCTION)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "EmbedFile.cmake: ${variable} is not set")
    endif()
endforeach()

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" digits)
math(EXPR size "${digits} / 2")

# 32 bytes to a line, then each byte as 0x.., (CMake's regular expressions have no {n} repeat).
string(REPEAT "." 64 line)
string(REGEX REPLACE "(${line})" "\\1\n" hex "${hex}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")

get_filename_component(name "${INPUT}" NAME)
file(WRITE "${OUTPUT}.tmp"
"// Generated by cmake/EmbedFile.cmake from ${name}: do not edit.
#include \"${HEADER}\"

#include <cstddef>
#include <span>

namespace rocketplot
{

namespace
{

// ${size} bytes. Not constexpr: MSVC compiles a constexpr array this large very slowly.
const unsigned char kData[${size}] = {
${bytes}
};

}  // namespace

std::span<const std::byte> ${FUNCTION}()
{
    return std::as_bytes(std::span(kData));
}

}  // namespace rocketplot
")
# Only replace the source when it changed, so that a re-run doesn't rebuild the library.
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
